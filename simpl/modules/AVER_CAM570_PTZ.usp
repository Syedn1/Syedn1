// AVER CAM570 PTZ Camera Driver
// Protocol: VISCA over UDP (port 52381)
//
// SIMPL LOGIC SYMBOLS IMPLEMENTED
// ─────────────────────────────────────────────────────────────────────────────
// INTERLOCK    Preset active feedback: only one of Preset1..4 Active_FB
//              can be high at a time.  _InterlockPreset(num) clears all
//              then sets the selected one.
//
// ONE-SHOT     Home_Position: pulses Moving_FB high for 2 s then clears it
//              (the camera reaches home faster than we can poll it).
//              Preset_Save: confirmation pulse – Moving_FB high 500 ms.
//              AutoTrack on/off: HTTP command sent as a 1 s ONE-SHOT so the
//              string output is present long enough for the TCP driver to send.
//
// STEPPER      Speed_Up / Speed_Down: adjust g_PanSpd and g_TiltSpd each press
//              by Speed_Step_Size (1 unit = 1 VISCA speed level).
//              Range: pan 1–24, tilt 1–20.
//              The current speeds are reflected on Pan_Speed_FB / Tilt_Speed_FB
//              analog outputs (scaled 0–65535).
//
// TIMER        Activity watchdog: if Moving_FB is left high (button stuck),
//              a Wait(5000, stuck_watchdog) automatically sends Stop after 5 s.
//              Auto-tracking heartbeat: while g_AutoTrack is active, a
//              Wait(60000, track_heartbeat) re-sends the tracking command
//              every 60 s in case the camera loses the session.
// ─────────────────────────────────────────────────────────────────────────────

#SYMBOL_NAME "AVER_CAM570_PTZ_v2"
#HINT "AVER CAM570 PTZ Camera - VISCA/UDP + SIMPL logic symbols - v2"
#CATEGORY "12"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

// ── DIGITAL INPUTS ────────────────────────────────────────────────────────────
DIGITAL_INPUT  Pan_Left,   Pan_Right;
DIGITAL_INPUT  Tilt_Up,    Tilt_Down;
DIGITAL_INPUT  Zoom_In,    Zoom_Out;
DIGITAL_INPUT  Focus_Far,  Focus_Near;
DIGITAL_INPUT  Focus_Auto;
DIGITAL_INPUT  Preset_1_Recall, Preset_2_Recall;
DIGITAL_INPUT  Preset_3_Recall, Preset_4_Recall;
DIGITAL_INPUT  Preset_Save;
DIGITAL_INPUT  AutoTrack_Toggle;
DIGITAL_INPUT  Home_Position;

// STEPPER inputs for pan/tilt speed
DIGITAL_INPUT  Speed_Up;         // STEPPER: increase pan+tilt speed 1 step
DIGITAL_INPUT  Speed_Down;       // STEPPER: decrease pan+tilt speed 1 step

// ── ANALOG INPUTS ─────────────────────────────────────────────────────────────
ANALOG_INPUT   Pan_Speed;         // Direct speed override from panel slider
ANALOG_INPUT   Tilt_Speed;
ANALOG_INPUT   Preset_Save_Slot;  // 1–8: which slot to save to

// ── DIGITAL OUTPUTS ───────────────────────────────────────────────────────────
DIGITAL_OUTPUT AutoTrack_FB;
// INTERLOCK group: only one preset active FB high at a time
DIGITAL_OUTPUT Preset1_Active_FB, Preset2_Active_FB;
DIGITAL_OUTPUT Preset3_Active_FB, Preset4_Active_FB;
DIGITAL_OUTPUT Moving_FB;
DIGITAL_OUTPUT Home_Active_FB;    // HIGH during home-position ONE-SHOT

// ── ANALOG OUTPUTS ────────────────────────────────────────────────────────────
ANALOG_OUTPUT  Pan_Pos_FB;
ANALOG_OUTPUT  Tilt_Pos_FB;
ANALOG_OUTPUT  Zoom_Pos_FB;
ANALOG_OUTPUT  Pan_Speed_FB;      // STEPPER current speed reflected to panel
ANALOG_OUTPUT  Tilt_Speed_FB;     // STEPPER current tilt speed reflected to panel

// ── STRING I/O ────────────────────────────────────────────────────────────────
STRING_OUTPUT  SerialOut;         // UDP payload out to VISCA server
BUFFER_INPUT   SerialIn[256];
STRING_OUTPUT  HTTP_Cmd_Out;      // REST command for auto-track API

// ── PARAMETERS ────────────────────────────────────────────────────────────────
STRING_PARAMETER  Camera_IP[16];
INTEGER_PARAMETER Default_Pan_Speed;    // 1–24 initial pan speed
INTEGER_PARAMETER Default_Tilt_Speed;  // 1–20 initial tilt speed
INTEGER_PARAMETER Camera_Address;       // VISCA camera address (1)
INTEGER_PARAMETER Speed_Step_Size;      // STEPPER step (1 = fine, 2 = coarse)

// ── INTERNAL VARS ─────────────────────────────────────────────────────────────
INTEGER g_AutoTrack;
INTEGER g_ActivePreset;   // INTERLOCK state: 0=none, 1–4=active preset
INTEGER g_SaveSlot;
INTEGER g_SeqNum;
INTEGER g_PanSpd;         // current pan speed (1–24), STEPPER managed
INTEGER g_TiltSpd;        // current tilt speed (1–20), STEPPER managed
INTEGER g_SpeedStep;      // STEPPER step size
STRING  g_ViscaStop[16];
STRING  g_ZoomStop[16];
STRING  g_FocusStop[16];
STRING  g_FocusAuto[16];
STRING  g_Home[16];
STRING  g_Cmd[32];

// ── HELPER FUNCTIONS ─────────────────────────────────────────────────────────

// Build and send VISCA over UDP (8-byte header + payload)
FUNCTION SendVISCA(STRING payload)
{
    STRING header[8];
    INTEGER pLen;
    pLen    = LEN(payload);
    g_SeqNum = g_SeqNum + 1;
    header  = CHR(1) + CHR(0);
    header  = header + CHR(pLen / 256) + CHR(pLen MOD 256);
    header  = header + CHR(0) + CHR(0);
    header  = header + CHR(g_SeqNum / 256) + CHR(g_SeqNum MOD 256);
    SerialOut = header + payload;
}

// Calculate VISCA speeds from current g_PanSpd / g_TiltSpd
FUNCTION CalcSpeeds()
{
    // Override with panel slider values if non-zero
    IF (Pan_Speed > 0)
    {
        g_PanSpd = Pan_Speed / 2730;
        IF (g_PanSpd < 1)  { g_PanSpd = 1; }
        IF (g_PanSpd > 24) { g_PanSpd = 24; }
    }
    IF (Tilt_Speed > 0)
    {
        g_TiltSpd = Tilt_Speed / 3276;
        IF (g_TiltSpd < 1)  { g_TiltSpd = 1; }
        IF (g_TiltSpd > 20) { g_TiltSpd = 20; }
    }
}

// Update analog feedback for current speed STEPPER values
FUNCTION _UpdateSpeedFB()
{
    Pan_Speed_FB  = g_PanSpd  * 2730;
    Tilt_Speed_FB = g_TiltSpd * 3276;
}

// ── INTERLOCK: preset active ─────────────────────────────────────────────────
// Clears all preset FBs then sets the one matching num.  num=0 clears all.
FUNCTION _InterlockPreset(INTEGER num)
{
    g_ActivePreset     = num;
    Preset1_Active_FB  = 0;
    Preset2_Active_FB  = 0;
    Preset3_Active_FB  = 0;
    Preset4_Active_FB  = 0;
    SWITCH (num)
    {
        CASE (1): { Preset1_Active_FB = 1; }
        CASE (2): { Preset2_Active_FB = 1; }
        CASE (3): { Preset3_Active_FB = 1; }
        CASE (4): { Preset4_Active_FB = 1; }
    }
}

// Send VISCA preset recall and INTERLOCK the active FB
FUNCTION _RecallPreset(INTEGER num)
{
    _InterlockPreset(num);
    g_Cmd = CHR(129) + CHR(1) + CHR(4) + CHR(63);
    g_Cmd = g_Cmd + CHR(2) + CHR(num - 1) + CHR(255);
    SendVISCA(g_Cmd);

    // ONE-SHOT: clear Moving_FB when VISCA completion response expected (~1 s)
    Moving_FB = 1;
    Wait(1000, preset_recall_done)
    {
        Moving_FB = 0;  // ONE-SHOT: camera has (likely) finished moving
    }
}

// ── ACTIVITY WATCHDOG TIMER ───────────────────────────────────────────────────
// Restarted on every PTZ key press.  If Moving_FB is still high after 5 s
// (e.g. operator walked away with key held), send Stop automatically.
FUNCTION _StartWatchdog()
{
    RetimeWait(5000, stuck_watchdog);
}

Wait(5000, stuck_watchdog)
{
    // TIMER: fire Stop if camera is still flagged as moving
    IF (Moving_FB)
    {
        SendVISCA(g_ViscaStop);
        Moving_FB = 0;
    }
}

// ── PAN / TILT ────────────────────────────────────────────────────────────────
PUSH Pan_Left
{
    CalcSpeeds();
    _InterlockPreset(0);              // INTERLOCK: clear preset FB while moving
    g_Cmd = CHR(129) + CHR(1) + CHR(6) + CHR(1);
    g_Cmd = g_Cmd + CHR(g_PanSpd) + CHR(g_TiltSpd) + CHR(1) + CHR(3) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();                 // TIMER: watchdog
}
RELEASE Pan_Left   { SendVISCA(g_ViscaStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

PUSH Pan_Right
{
    CalcSpeeds();
    _InterlockPreset(0);
    g_Cmd = CHR(129) + CHR(1) + CHR(6) + CHR(1);
    g_Cmd = g_Cmd + CHR(g_PanSpd) + CHR(g_TiltSpd) + CHR(2) + CHR(3) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();
}
RELEASE Pan_Right  { SendVISCA(g_ViscaStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

PUSH Tilt_Up
{
    CalcSpeeds();
    _InterlockPreset(0);
    g_Cmd = CHR(129) + CHR(1) + CHR(6) + CHR(1);
    g_Cmd = g_Cmd + CHR(g_PanSpd) + CHR(g_TiltSpd) + CHR(3) + CHR(1) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();
}
RELEASE Tilt_Up    { SendVISCA(g_ViscaStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

PUSH Tilt_Down
{
    CalcSpeeds();
    _InterlockPreset(0);
    g_Cmd = CHR(129) + CHR(1) + CHR(6) + CHR(1);
    g_Cmd = g_Cmd + CHR(g_PanSpd) + CHR(g_TiltSpd) + CHR(3) + CHR(2) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();
}
RELEASE Tilt_Down  { SendVISCA(g_ViscaStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

// ── ZOOM ──────────────────────────────────────────────────────────────────────
PUSH Zoom_In
{
    INTEGER zs;
    CalcSpeeds();
    zs = g_PanSpd / 3;
    IF (zs < 1) { zs = 1; }
    IF (zs > 7) { zs = 7; }
    g_Cmd = CHR(129) + CHR(1) + CHR(4) + CHR(7);
    g_Cmd = g_Cmd + CHR(32 + zs) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();
}
RELEASE Zoom_In    { SendVISCA(g_ZoomStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

PUSH Zoom_Out
{
    INTEGER zs;
    CalcSpeeds();
    zs = g_PanSpd / 3;
    IF (zs < 1) { zs = 1; }
    IF (zs > 7) { zs = 7; }
    g_Cmd = CHR(129) + CHR(1) + CHR(4) + CHR(7);
    g_Cmd = g_Cmd + CHR(48 + zs) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();
}
RELEASE Zoom_Out   { SendVISCA(g_ZoomStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

// ── FOCUS ─────────────────────────────────────────────────────────────────────
PUSH Focus_Auto  { SendVISCA(g_FocusAuto); }

PUSH Focus_Far
{
    g_Cmd = CHR(129) + CHR(1) + CHR(4) + CHR(8) + CHR(40) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();
}
RELEASE Focus_Far  { SendVISCA(g_FocusStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

PUSH Focus_Near
{
    g_Cmd = CHR(129) + CHR(1) + CHR(4) + CHR(8) + CHR(56) + CHR(255);
    SendVISCA(g_Cmd);
    Moving_FB = 1;
    _StartWatchdog();
}
RELEASE Focus_Near { SendVISCA(g_FocusStop); Moving_FB = 0; CancelWait(stuck_watchdog); }

// ── HOME POSITION ─────────────────────────────────────────────────────────────
// ONE-SHOT: Home_Active_FB goes high and auto-clears after 2 s
PUSH Home_Position
{
    SendVISCA(g_Home);
    _InterlockPreset(0);
    Home_Active_FB = 1;
    Moving_FB      = 1;
    // ONE-SHOT: clear after estimated move time
    Wait(2000, home_done)
    {
        Home_Active_FB = 0;
        Moving_FB      = 0;
    }
}

// ── PRESETS (INTERLOCK active FB) ─────────────────────────────────────────────
PUSH Preset_1_Recall { _RecallPreset(1); }
PUSH Preset_2_Recall { _RecallPreset(2); }
PUSH Preset_3_Recall { _RecallPreset(3); }
PUSH Preset_4_Recall { _RecallPreset(4); }

PUSH Preset_Save
{
    INTEGER slot;
    slot = Preset_Save_Slot;
    IF (slot < 1) { slot = 1; }
    IF (slot > 8) { slot = 8; }
    g_Cmd = CHR(129) + CHR(1) + CHR(4) + CHR(63);
    g_Cmd = g_Cmd + CHR(1) + CHR(slot - 1) + CHR(255);
    SendVISCA(g_Cmd);
    g_SaveSlot = slot;
    // ONE-SHOT: confirmation pulse on Moving_FB (500 ms)
    Moving_FB = 1;
    Wait(500, preset_save_done) { Moving_FB = 0; }
}

// ── AUTO TRACKING ─────────────────────────────────────────────────────────────
PUSH AutoTrack_Toggle
{
    g_AutoTrack  = !g_AutoTrack;
    AutoTrack_FB = g_AutoTrack;

    IF (g_AutoTrack)
    {
        HTTP_Cmd_Out = "PUT http://" + Camera_IP + "/api/v1/camera/tracking";
        // TIMER: heartbeat – re-send tracking command every 60 s
        Wait(60000, track_heartbeat)
        {
            IF (g_AutoTrack)
            {
                HTTP_Cmd_Out = "PUT http://" + Camera_IP + "/api/v1/camera/tracking";
                RetimeWait(60000, track_heartbeat);
            }
        }
    }
    ELSE
    {
        HTTP_Cmd_Out = "PUT http://" + Camera_IP + "/api/v1/camera/tracking/off";
        CancelWait(track_heartbeat);   // TIMER: stop heartbeat when tracking off
    }
}

// ── STEPPER: pan/tilt speed ───────────────────────────────────────────────────
// Speed_Up / Speed_Down adjust both pan and tilt speeds by g_SpeedStep.
PUSH Speed_Up
{
    g_PanSpd  = g_PanSpd  + g_SpeedStep;
    IF (g_PanSpd  > 24) { g_PanSpd  = 24; }
    g_TiltSpd = g_TiltSpd + g_SpeedStep;
    IF (g_TiltSpd > 20) { g_TiltSpd = 20; }
    _UpdateSpeedFB();
}

PUSH Speed_Down
{
    g_PanSpd  = g_PanSpd  - g_SpeedStep;
    IF (g_PanSpd  < 1) { g_PanSpd  = 1; }
    g_TiltSpd = g_TiltSpd - g_SpeedStep;
    IF (g_TiltSpd < 1) { g_TiltSpd = 1; }
    _UpdateSpeedFB();
}

// ── RX PARSER ─────────────────────────────────────────────────────────────────
CHANGE SerialIn
{
    // VISCA responses: ACK = 0x90 0x4n 0xFF, Completion = 0x90 0x5n 0xFF
    // For PTZ the ACK/Completion simply confirm delivery; no state changes needed.
}

// ── STARTUP ───────────────────────────────────────────────────────────────────
Function Main()
{
    g_SeqNum      = 0;
    g_AutoTrack   = 0;
    g_ActivePreset = 0;

    // STEPPER: initialise from parameters (fall back to safe defaults)
    g_PanSpd  = Default_Pan_Speed;
    g_TiltSpd = Default_Tilt_Speed;
    IF (g_PanSpd  < 1 || g_PanSpd  > 24) { g_PanSpd  = 8; }
    IF (g_TiltSpd < 1 || g_TiltSpd > 20) { g_TiltSpd = 6; }
    g_SpeedStep = Speed_Step_Size;
    IF (g_SpeedStep < 1) { g_SpeedStep = 1; }
    IF (g_SpeedStep > 5) { g_SpeedStep = 5; }

    // Reflect initial speed on analog outputs
    _UpdateSpeedFB();

    // Pre-build constant VISCA commands
    g_ViscaStop = CHR(129) + CHR(1) + CHR(6) + CHR(1);
    g_ViscaStop = g_ViscaStop + CHR(8) + CHR(6) + CHR(3) + CHR(3) + CHR(255);
    g_ZoomStop  = CHR(129) + CHR(1) + CHR(4) + CHR(7) + CHR(0) + CHR(255);
    g_FocusStop = CHR(129) + CHR(1) + CHR(4) + CHR(8) + CHR(0) + CHR(255);
    g_FocusAuto = CHR(129) + CHR(1) + CHR(4) + CHR(56) + CHR(2) + CHR(255);
    g_Home      = CHR(129) + CHR(1) + CHR(6) + CHR(4) + CHR(255);
}
