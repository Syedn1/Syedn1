// Sony BRAVIA 98B253L Professional Display Driver
// Protocol: RS-232 / IRCC-IP Control
//
// SIMPL LOGIC SYMBOLS IMPLEMENTED
// ─────────────────────────────────────────────────────────────────────────────
// ONE-SHOT     PowerOn triggers a warmup guard: g_Warming = 1 for
//              Power_On_Warmup_MS, then releases.  Input commands are
//              blocked during this window so the display doesn't drop them.
//              Volume_Up / Volume_Down each send a 200 ms command pulse.
//
// SR LATCH     g_Power tracks sustained power state (Set on PowerOn,
//              Reset on PowerOff or comms loss).
//
// TIMER        Recurring auto-poll: fires every Poll_Interval_Sec seconds
//              and queries POWR + INPT.  Re-arms itself after each cycle.
//              Stops automatically when power is off.
//
// ANALOG RAMP  Volume_Level CHANGE drives a smooth 1-step-per-40 ms ramp
//              from the current hardware volume to the requested level,
//              so rapid slider drags don't spam the display with commands.
// ─────────────────────────────────────────────────────────────────────────────

#SYMBOL_NAME "Sony_BRAVIA_Display_v2"
#HINT "Sony BRAVIA 98B253L RS-232/IP Control Driver - v2 with SIMPL logic"
#CATEGORY "11"
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

// ── DIGITAL INPUTS ────────────────────────────────────────────────────────────
DIGITAL_INPUT  PowerOn;
DIGITAL_INPUT  PowerOff;
DIGITAL_INPUT  Input1_Select, Input2_Select, Input3_Select;
DIGITAL_INPUT  Input4_Select, Input5_Select, Input6_Select;
DIGITAL_INPUT  Volume_Up;             // ONE-SHOT: single step up
DIGITAL_INPUT  Volume_Down;           // ONE-SHOT: single step down
DIGITAL_INPUT  Mute_Toggle;
DIGITAL_INPUT  Poll;                  // Manual poll trigger

// ── ANALOG INPUTS ─────────────────────────────────────────────────────────────
ANALOG_INPUT   Volume_Level;          // 0–65535; triggers ANALOG RAMP

// ── DIGITAL OUTPUTS ───────────────────────────────────────────────────────────
DIGITAL_OUTPUT Power_On_FB;
DIGITAL_OUTPUT Power_Off_FB;
DIGITAL_OUTPUT Input1_FB, Input2_FB, Input3_FB;
DIGITAL_OUTPUT Input4_FB, Input5_FB, Input6_FB;
DIGITAL_OUTPUT Mute_FB;
DIGITAL_OUTPUT Comms_OK;
DIGITAL_OUTPUT Warming_FB;            // HIGH during warmup ONE-SHOT window

// ── ANALOG OUTPUTS ────────────────────────────────────────────────────────────
ANALOG_OUTPUT  Volume_FB;

// ── STRING I/O ────────────────────────────────────────────────────────────────
STRING_OUTPUT  SerialOut;
BUFFER_INPUT   SerialIn[256];

// ── PARAMETERS ────────────────────────────────────────────────────────────────
STRING_PARAMETER  DisplayID[2];
INTEGER_PARAMETER Poll_Interval_Sec;    // Seconds between auto-polls
INTEGER_PARAMETER Power_On_Warmup_MS;   // ONE-SHOT warmup window length (ms)

// ── INTERNAL VARS ─────────────────────────────────────────────────────────────
// SR LATCH state
INTEGER g_Power;       // 0=off, 1=on (SR latch: Set by PowerOn, Reset by PowerOff)
INTEGER g_Input;
INTEGER g_Muted;
INTEGER g_Warming;     // ONE-SHOT flag: 1 during warmup (blocks input selection)
INTEGER g_CommsOK;

// ANALOG RAMP state
INTEGER g_VolCurrent;  // last volume sent to display (0–63)
INTEGER g_VolTarget;   // ramp target (0–63)

STRING  g_RxBuf[256];
STRING  g_STX[1];
STRING  g_ETX[1];
STRING  g_VolStr[16];
STRING  g_Code[4];

// ── HELPER FUNCTIONS ─────────────────────────────────────────────────────────

FUNCTION _ClearInputFB()
{
    Input1_FB = 0; Input2_FB = 0; Input3_FB = 0;
    Input4_FB = 0; Input5_FB = 0; Input6_FB = 0;
}

FUNCTION SendCmd(STRING cmd)
{
    SerialOut = g_STX + cmd + g_ETX;
}

FUNCTION SendQuery(STRING cmd)
{
    SerialOut = g_STX + cmd + "????" + g_ETX;
}

// INTERLOCK: input selection (6-way exclusive, guarded by warmup ONE-SHOT)
FUNCTION _SelectInput(INTEGER num, STRING inpCmd)
{
    IF (!g_Power)   { RETURN; }
    IF (g_Warming)  { RETURN; }   // Blocked during power-on warmup ONE-SHOT
    g_Input = num;
    SendCmd(inpCmd);
    _ClearInputFB();
    SWITCH (num)
    {
        CASE (1): { Input1_FB = 1; }
        CASE (2): { Input2_FB = 1; }
        CASE (3): { Input3_FB = 1; }
        CASE (4): { Input4_FB = 1; }
        CASE (5): { Input5_FB = 1; }
        CASE (6): { Input6_FB = 1; }
    }
}

// ── ANALOG RAMP: volume ───────────────────────────────────────────────────────
// Sends one VOLU command every 40 ms until display volume reaches target.
FUNCTION _SendVolStep()
{
    g_VolStr = "000" + ITOA(g_VolCurrent);
    g_VolStr = RIGHT(g_VolStr, 4);
    SendCmd("VOLU" + g_VolStr);
    Volume_FB = g_VolCurrent * 1040;
}

FUNCTION _DoVolRampStep()
{
    IF (g_VolCurrent < g_VolTarget)
    {
        g_VolCurrent = g_VolCurrent + 1;
        _SendVolStep();
        IF (g_VolCurrent < g_VolTarget)
        {
            Wait(40, vol_ramp_tick) { _DoVolRampStep(); }
        }
    }
    ELSE IF (g_VolCurrent > g_VolTarget)
    {
        g_VolCurrent = g_VolCurrent - 1;
        _SendVolStep();
        IF (g_VolCurrent > g_VolTarget)
        {
            Wait(40, vol_ramp_tick) { _DoVolRampStep(); }
        }
    }
}

FUNCTION _RampVolTo(INTEGER target)
{
    // Scale 0–65535 down to display range 0–63
    INTEGER scaled;
    scaled = target / 1040;
    IF (scaled > 63) { scaled = 63; }
    g_VolTarget = scaled;
    CancelWait(vol_ramp_tick);
    IF (g_VolCurrent <> g_VolTarget)
    {
        Wait(40, vol_ramp_tick) { _DoVolRampStep(); }
    }
}

// ── TIMER: recurring auto-poll ────────────────────────────────────────────────
// Re-arms itself after every cycle while power is on.
FUNCTION _StartPollTimer()
{
    CancelWait(poll_timer);
    IF (Poll_Interval_Sec > 0)
    {
        Wait(Poll_Interval_Sec * 1000, poll_timer)
        {
            IF (g_Power)
            {
                SendQuery("POWR");          // Poll power status
                // Re-arm recurring TIMER
                _StartPollTimer();
            }
        }
    }
}

// ── SR LATCH: Power On ────────────────────────────────────────────────────────
// Set side of SR latch.  Starts ONE-SHOT warmup guard.
PUSH PowerOn
{
    SendCmd("POWR0001");
    g_Power      = 1;        // SR latch: Set
    Power_On_FB  = 1;
    Power_Off_FB = 0;
    Comms_OK     = 1;
    g_CommsOK    = 1;

    // ONE-SHOT: block input selection for warmup period
    g_Warming    = 1;
    Warming_FB   = 1;
    Wait(Power_On_Warmup_MS, warmup_done)
    {
        g_Warming  = 0;     // ONE-SHOT fires: warmup complete
        Warming_FB = 0;
    }

    // TIMER: start recurring auto-poll
    _StartPollTimer();
}

// SR LATCH: Power Off – Reset side
PUSH PowerOff
{
    SendCmd("POWR0000");
    g_Power      = 0;        // SR latch: Reset
    Power_On_FB  = 0;
    Power_Off_FB = 1;
    g_Input      = 0;
    g_Warming    = 0;
    Warming_FB   = 0;
    _ClearInputFB();
    CancelWait(warmup_done);
    CancelWait(vol_ramp_tick);
    CancelWait(poll_timer);  // Stop recurring TIMER when off
}

// ── INPUT SELECTION (INTERLOCK via _SelectInput, guarded by warmup ONE-SHOT) ─
PUSH Input1_Select { _SelectInput(1, "INPT00010001"); }
PUSH Input2_Select { _SelectInput(2, "INPT00010002"); }
PUSH Input3_Select { _SelectInput(3, "INPT00010003"); }
PUSH Input4_Select { _SelectInput(4, "INPT00010004"); }
PUSH Input5_Select { _SelectInput(5, "INPT00010005"); }
PUSH Input6_Select { _SelectInput(6, "INPT00000001"); }  // HDMI-6/HDMI-CEC

// ── VOLUME ────────────────────────────────────────────────────────────────────
// Analog ramp target: panel slider drives ramp, not immediate command.
CHANGE Volume_Level
{
    IF (g_Power) { _RampVolTo(Volume_Level); }
}

// ONE-SHOT: Volume_Up sends a single remote-key command pulse
PUSH Volume_Up
{
    IF (!g_Power) { RETURN; }
    SendCmd("RCKY00000041");           // Sony RC volume up key
}

// ONE-SHOT: Volume_Down sends a single remote-key command pulse
PUSH Volume_Down
{
    IF (!g_Power) { RETURN; }
    SendCmd("RCKY00000042");           // Sony RC volume down key
}

// SR latch: Mute state
PUSH Mute_Toggle
{
    g_Muted = !g_Muted;
    Mute_FB = g_Muted;
    IF (g_Muted) { SendCmd("AMUT0001"); }
    ELSE          { SendCmd("AMUT0000"); }
}

// ── MANUAL POLL ───────────────────────────────────────────────────────────────
PUSH Poll
{
    SendQuery("POWR");
}

// ── RX PARSER ─────────────────────────────────────────────────────────────────
CHANGE SerialIn
{
    STRING resp[64];
    INTEGER sPos, ePos;

    g_RxBuf = g_RxBuf + SerialIn;

    sPos = FIND(g_STX, g_RxBuf);
    ePos = FIND(g_ETX, g_RxBuf);

    WHILE (sPos > 0 && ePos > sPos)
    {
        resp = MID(g_RxBuf, sPos + 1, ePos - sPos - 1);
        g_RxBuf = RIGHT(g_RxBuf, LEN(g_RxBuf) - ePos);
        g_CommsOK = 1;
        Comms_OK  = 1;

        IF (LEFT(resp, 4) = "POWR")
        {
            IF (RIGHT(resp, 4) = "0001")
            {
                Power_On_FB = 1; Power_Off_FB = 0; g_Power = 1;  // SR: Set
                _StartPollTimer();  // Ensure timer is running
            }
            IF (RIGHT(resp, 4) = "0000")
            {
                Power_On_FB = 0; Power_Off_FB = 1; g_Power = 0;  // SR: Reset
                CancelWait(poll_timer);
            }
        }

        IF (LEFT(resp, 4) = "INPT")
        {
            g_Code = RIGHT(resp, 4);
            _ClearInputFB();
            IF (g_Code = "0001") { Input1_FB = 1; g_Input = 1; }
            IF (g_Code = "0002") { Input2_FB = 1; g_Input = 2; }
            IF (g_Code = "0003") { Input3_FB = 1; g_Input = 3; }
            IF (g_Code = "0004") { Input4_FB = 1; g_Input = 4; }
            IF (g_Code = "0005") { Input5_FB = 1; g_Input = 5; }
        }

        IF (LEFT(resp, 4) = "VOLU")
        {
            INTEGER v;
            v = ATOI(RIGHT(resp, 4));
            g_VolCurrent = v;
            Volume_FB    = v * 1040;
        }

        sPos = FIND(g_STX, g_RxBuf);
        ePos = FIND(g_ETX, g_RxBuf);
    }
}

// ── STARTUP ───────────────────────────────────────────────────────────────────
Function Main()
{
    g_STX      = CHR(2);
    g_ETX      = CHR(3);
    g_Power    = 0;
    g_Input    = 0;
    g_Muted    = 0;
    g_Warming  = 0;
    g_CommsOK  = 0;
    g_VolCurrent = 0;
    g_VolTarget  = 0;

    Power_Off_FB = 1;
    Warming_FB   = 0;
}
